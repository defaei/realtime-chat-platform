<!DOCTYPE html>
<html>
  <head>
    <style>
      main {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4rem;
        background-color: black;
        width: 100%;
        height: 100%;
        text-align: center;
      }

      p {
        font-size: large;
      }

      b {
        color: blue;
        font-size: x-large;
      }
    </style>
  </head>
  <body>
    <main>
      <h1>Welcome Back <%= username %> 👋</h1>
      <p>We’re happy to see you again here!</p>
      <p>Your Verification Code: <b><%= code %></b></p>
      <p>Enjoy Chating With your Favorite People</p>
    </main>
  </body>
</html>
